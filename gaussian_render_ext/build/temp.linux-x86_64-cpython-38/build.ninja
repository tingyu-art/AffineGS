ninja_required_version = 1.3
cxx = /usr/bin/g++-9
nvcc = /media/newdisk/junjie/cuda-11.2/bin/nvcc

cflags = -Wsign-compare -DNDEBUG -g -fwrapv -O3 -Wall -Wstrict-prototypes -fPIC -I/media/newdisk/junjie/miniconda3/envs/ldm/lib/python3.8/site-packages/torch/include -I/media/newdisk/junjie/miniconda3/envs/ldm/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/media/newdisk/junjie/miniconda3/envs/ldm/lib/python3.8/site-packages/torch/include/TH -I/media/newdisk/junjie/miniconda3/envs/ldm/lib/python3.8/site-packages/torch/include/THC -I/media/newdisk/junjie/cuda-11.2/include -I/media/newdisk/junjie/miniconda3/envs/ldm/include/python3.8 -c
post_cflags = -O3 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=gaussian_render_ext -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
cuda_cflags = -I/media/newdisk/junjie/miniconda3/envs/ldm/lib/python3.8/site-packages/torch/include -I/media/newdisk/junjie/miniconda3/envs/ldm/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/media/newdisk/junjie/miniconda3/envs/ldm/lib/python3.8/site-packages/torch/include/TH -I/media/newdisk/junjie/miniconda3/envs/ldm/lib/python3.8/site-packages/torch/include/THC -I/media/newdisk/junjie/cuda-11.2/include -I/media/newdisk/junjie/miniconda3/envs/ldm/include/python3.8 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=gaussian_render_ext -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -ccbin /usr/bin/gcc-9 -std=c++14
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /media/newdisk/junjie/2dGS-representation/gaussian_render_ext/build/temp.linux-x86_64-cpython-38/gaussian_render.o: compile /media/newdisk/junjie/2dGS-representation/gaussian_render_ext/gaussian_render.cpp
build /media/newdisk/junjie/2dGS-representation/gaussian_render_ext/build/temp.linux-x86_64-cpython-38/gaussian_render_kernel.o: cuda_compile /media/newdisk/junjie/2dGS-representation/gaussian_render_ext/gaussian_render_kernel.cu







